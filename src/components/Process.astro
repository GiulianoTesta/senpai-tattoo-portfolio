---
import { process } from '../data/site';
---
<section id="process" data-ch="CH.04">
  <div class="stick wrap">
    <div>
      <div class="chapter"><h2>Dal foglio<br>alla pelle</h2></div>
      <ol class="layers" id="layers">
        {process.map((p, i) => <li data-note={p.note}><span class="mono">{String(i + 1).padStart(2, '0')}</span><span class="ln">{p.name}</span></li>)}
      </ol>
      <p class="note" id="note" aria-live="polite">{process[0].note}</p>
    </div>
    <div class="panel">
      <span class="lbl mono" id="lbl">Strato 01 / 06</span><span class="lbl2 mono">Scala 1:1 · 12 × 12 cm</span>
      <svg id="art" viewBox="0 0 400 400" role="img" aria-label="Disegno di onda e sole che si costruisce strato dopo strato">
        <defs><pattern id="ht" width="6" height="6" patternUnits="userSpaceOnUse"><circle cx="3" cy="3" r="1.4" fill="#120f1a"/></pattern></defs>
        <g id="L0" fill="none" stroke="#2f6bff" stroke-width="1.2" stroke-dasharray="3 4">
          <circle cx="250" cy="150" r="78"/><path d="M30 300 C90 210 170 210 210 270 C230 300 280 300 300 260 C320 220 370 230 380 270"/><path d="M40 340 C120 300 200 330 380 320"/>
        </g>
        <g id="L1" style="opacity:0" fill="none" stroke="#7c4dff" stroke-width="1.8">
          <circle cx="250" cy="150" r="80"/><path d="M28 302 C88 208 172 208 212 268 C232 298 278 298 298 258 C318 218 372 228 382 270 L382 380 L28 380 Z"/><path d="M60 300 C100 250 150 250 175 290"/><path d="M110 330 C150 290 200 300 230 330"/>
        </g>
        <g id="L3" style="opacity:0"><path d="M28 302 C88 208 172 208 212 268 C232 298 278 298 298 258 C318 218 372 228 382 270 L382 380 L28 380 Z" fill="url(#ht)" opacity=".5"/></g>
        <g id="L4" style="opacity:0">
          <circle cx="250" cy="150" r="78" fill="#ff2e63"/>
          <path d="M28 302 C88 208 172 208 212 268 C232 298 278 298 298 258 C318 218 372 228 382 270 L382 380 L28 380 Z" fill="#2f6bff" opacity=".75"/>
          <path d="M60 300 C100 250 150 250 175 290 L175 380 L60 380 Z" fill="#22d3ee" opacity=".6"/>
          <circle cx="90" cy="150" r="10" fill="#ffd23f"/><circle cx="130" cy="120" r="6" fill="#ffd23f"/><circle cx="150" cy="180" r="8" fill="#a3e635"/>
        </g>
        <g id="L2" class="draw" fill="none" stroke="#120f1a" stroke-width="4" stroke-linecap="round">
          <circle cx="250" cy="150" r="80" style="--len:503"/>
          <path d="M28 302 C88 208 172 208 212 268 C232 298 278 298 298 258 C318 218 372 228 382 270" style="--len:520"/>
          <path d="M60 300 C100 250 150 250 175 290" style="--len:170"/>
          <path d="M110 330 C150 290 200 300 230 330" style="--len:160"/>
          <path d="M28 380 L382 380" style="--len:354"/>
          <path d="M300 300 C320 280 345 285 355 305" style="--len:80"/>
        </g>
        <text id="L5" x="40" y="90" style="opacity:0" font-family="Dela Gothic One, sans-serif" font-size="44" fill="#120f1a">波</text>
      </svg>
    </div>
  </div>
</section>

<style>
#process{height:520vh;background:var(--c-cyan);color:var(--ink)}
.stick{position:sticky;top:0;height:100svh;display:grid;grid-template-rows:auto 1fr;gap:16px;padding-block:88px 72px;overflow:hidden}
@media(min-width:900px){.stick{grid-template-columns:5fr 7fr;grid-template-rows:1fr;align-items:center;gap:48px}}
.chapter{margin-bottom:20px}
.layers{list-style:none;margin:0;padding:0;display:grid;gap:2px}
.layers li{display:flex;gap:14px;align-items:baseline;opacity:.35;transition:opacity .3s,transform .3s}
.layers li:global(.on){opacity:1}
.layers li:global(.now){transform:translateX(12px)}
.layers li:global(.now) .ln{background:var(--ink);color:var(--c-yellow);padding:0 .2em}
.ln{font-family:var(--display);font-size:clamp(20px,2.8vw,38px);line-height:1.2}
.note{margin:16px 0 0;min-height:3.2em;max-width:40ch;font-weight:700}
.panel{position:relative;justify-self:center;align-self:center;width:min(100%,58vh,620px);aspect-ratio:1;border:4px solid var(--ink);background:var(--paper);box-shadow:12px 12px 0 var(--c-rose);overflow:hidden}
svg{width:100%;height:100%;display:block}
.lbl{position:absolute;left:10px;top:8px;color:#4a4458}
.lbl2{position:absolute;right:10px;bottom:8px;color:#4a4458}
#art g,#art text{transition:opacity .5s}
.draw path,.draw circle{stroke-dasharray:var(--len);stroke-dashoffset:calc(var(--len) * (1 - var(--p,0)))}
@media(max-width:899px){.layers{grid-template-columns:repeat(2,1fr)}.note{min-height:4.8em}}
@media (prefers-reduced-motion:reduce){#process{height:auto}.stick{position:relative;height:auto}}
</style>
