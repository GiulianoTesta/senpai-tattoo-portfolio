---
// Mascotte originali dello studio (non personaggi di serie esistenti, per evitare problemi di copyright).
interface Props { kind?: 'senpai' | 'kitsune' | 'oni'; class?: string; label?: string }
const { kind = 'senpai', class: cls = '', label } = Astro.props;
---
<svg class:list={['mascot', `mascot-${kind}`, cls]} viewBox="0 0 200 240" role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'}>
  {kind === 'senpai' && (
    <g>
      <rect x="52" y="150" width="96" height="86" rx="34" fill="#2f6bff" stroke="#120f1a" stroke-width="5"/>
      <path d="M86 156 L100 178 L114 156" fill="none" stroke="#120f1a" stroke-width="5"/>
      <g class="arm"><path d="M146 172 Q178 150 176 116" fill="none" stroke="#120f1a" stroke-width="16" stroke-linecap="round"/><path d="M146 172 Q178 150 176 116" fill="none" stroke="#2f6bff" stroke-width="8" stroke-linecap="round"/><circle cx="176" cy="110" r="12" fill="#ffe1cc" stroke="#120f1a" stroke-width="5"/></g>
      <circle cx="100" cy="96" r="64" fill="#ffe1cc" stroke="#120f1a" stroke-width="5"/>
      <path d="M36 92 L44 46 L62 64 L74 28 L92 54 L106 20 L118 52 L140 30 L144 62 L166 50 L164 92 Q150 66 100 66 Q50 66 36 92 Z" fill="#120f1a"/>
      <rect x="38" y="70" width="124" height="16" rx="4" fill="#ff2e63" stroke="#120f1a" stroke-width="4"/>
      <text x="100" y="83" text-anchor="middle" font-family="Dela Gothic One, sans-serif" font-size="12" fill="#fff6ec">先輩</text>
      <g class="eyes"><ellipse cx="76" cy="106" rx="11" ry="15" fill="#120f1a"/><ellipse cx="124" cy="106" rx="11" ry="15" fill="#120f1a"/><circle cx="80" cy="100" r="4" fill="#fff"/><circle cx="128" cy="100" r="4" fill="#fff"/></g>
      <ellipse cx="60" cy="128" rx="10" ry="6" fill="#ff8fab" opacity=".8"/><ellipse cx="140" cy="128" rx="10" ry="6" fill="#ff8fab" opacity=".8"/>
      <path d="M90 130 Q100 140 110 130" fill="none" stroke="#120f1a" stroke-width="4" stroke-linecap="round"/>
    </g>
  )}
  {kind === 'kitsune' && (
    <g>
      <path d="M150 200 Q196 170 184 120 Q170 160 140 170 Z" fill="#ff7a1a" stroke="#120f1a" stroke-width="5" class="tail"/>
      <rect x="58" y="150" width="84" height="84" rx="32" fill="#ff7a1a" stroke="#120f1a" stroke-width="5"/>
      <path d="M44 100 L52 26 L92 60 Z" fill="#ff7a1a" stroke="#120f1a" stroke-width="5" stroke-linejoin="round"/>
      <path d="M156 100 L148 26 L108 60 Z" fill="#ff7a1a" stroke="#120f1a" stroke-width="5" stroke-linejoin="round"/>
      <circle cx="100" cy="104" r="60" fill="#fff6ec" stroke="#120f1a" stroke-width="5"/>
      <path d="M62 92 Q76 82 88 96" fill="none" stroke="#ff2e63" stroke-width="6" stroke-linecap="round"/>
      <path d="M138 92 Q124 82 112 96" fill="none" stroke="#ff2e63" stroke-width="6" stroke-linecap="round"/>
      <g class="eyes"><path d="M66 110 Q76 100 86 110" fill="none" stroke="#120f1a" stroke-width="5" stroke-linecap="round"/><path d="M114 110 Q124 100 134 110" fill="none" stroke="#120f1a" stroke-width="5" stroke-linecap="round"/></g>
      <ellipse cx="100" cy="130" rx="7" ry="5" fill="#120f1a"/>
      <path d="M100 135 Q92 146 84 140 M100 135 Q108 146 116 140" fill="none" stroke="#120f1a" stroke-width="4" stroke-linecap="round"/>
    </g>
  )}
  {kind === 'oni' && (
    <g>
      <rect x="56" y="150" width="88" height="84" rx="32" fill="#a3e635" stroke="#120f1a" stroke-width="5"/>
      <path d="M58 64 L44 18 L82 48 Z" fill="#ffd23f" stroke="#120f1a" stroke-width="5" stroke-linejoin="round"/>
      <path d="M142 64 L156 18 L118 48 Z" fill="#ffd23f" stroke="#120f1a" stroke-width="5" stroke-linejoin="round"/>
      <circle cx="100" cy="104" r="62" fill="#ff2e63" stroke="#120f1a" stroke-width="5"/>
      <path d="M50 70 Q100 30 150 70 Q130 56 100 58 Q70 56 50 70 Z" fill="#120f1a"/>
      <g class="eyes"><ellipse cx="76" cy="102" rx="12" ry="14" fill="#fff6ec" stroke="#120f1a" stroke-width="4"/><ellipse cx="124" cy="102" rx="12" ry="14" fill="#fff6ec" stroke="#120f1a" stroke-width="4"/><circle cx="78" cy="104" r="6" fill="#120f1a"/><circle cx="122" cy="104" r="6" fill="#120f1a"/></g>
      <path d="M70 134 Q100 152 130 134" fill="#fff6ec" stroke="#120f1a" stroke-width="4"/>
      <path d="M80 136 L84 146 L88 138 M112 138 L116 146 L120 136" fill="#fff6ec" stroke="#120f1a" stroke-width="3"/>
    </g>
  )}
</svg>

<style>
.mascot{overflow:visible}
.mascot .arm{transform-origin:146px 172px;animation:wave 1.6s ease-in-out infinite}
.mascot .tail{transform-origin:150px 190px;animation:wave 2.2s ease-in-out infinite}
.mascot .eyes{transform-box:fill-box;transform-origin:center;animation:blinkEyes 4s infinite}
@keyframes wave{0%,100%{transform:rotate(0)}50%{transform:rotate(-18deg)}}
@keyframes blinkEyes{0%,92%,100%{transform:scaleY(1)}95%{transform:scaleY(.1)}}
</style>
