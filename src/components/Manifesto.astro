---
const text = 'Ogni tatuaggio è il primo capitolo di una storia che porterai con te. Noi siamo i tuoi senpai: ti guidiamo dal primo schizzo fino alla pelle guarita.';
const hl = ['tatuaggio', 'capitolo', 'senpai:', 'pelle'];
---
<section id="patto" class="manifesto-sec wrap pad" data-ch="CH.01">
  <div class="chapter"><span class="mono">Capitolo 01</span><span class="mono">Il patto</span></div>
  <p class="manifesto" id="manifesto">{text.split(' ').map((w) => <><span class:list={['w', hl.includes(w) && 'hl']}>{w}</span>{' '}</>)}</p>
</section>

<style>
.manifesto-sec{background:var(--c-yellow);color:var(--ink);overflow:hidden}
.manifesto-sec::before{content:"";position:absolute;inset:0;color:var(--c-orange);opacity:.35;background-image:radial-gradient(currentColor 2px,transparent 2.5px);background-size:14px 14px;mask-image:linear-gradient(120deg,transparent 40%,#000)}
.manifesto{position:relative;font-family:var(--display);font-size:clamp(28px,4.4vw,64px);line-height:1.15;max-width:21ch;margin:0;text-wrap:balance}
.w{opacity:.2;transition:opacity .3s}
.w:global(.on){opacity:1}
.hl{background:var(--c-rose);color:var(--paper);padding:0 .12em;box-decoration-break:clone}
@media (prefers-reduced-motion:reduce){.w{opacity:1}}
</style>
