---
import { studio } from '../data/site';
const letters = ['S', 'E', 'N', 'P', 'A', 'I'];
const colors = ['rose', 'yellow', 'cyan', 'lime', 'orange', 'violet'];
---
<section id="hero" class="wrap" data-ch="CH.00">
  <canvas id="speed" aria-hidden="true"></canvas>
  <div class="kanji-v" aria-hidden="true">先輩<small>タトゥースタジオ</small></div>
  <div class="sfx" aria-hidden="true">ドン!</div>
  <h1 class="hero-title"><span class="sr">Senpai Tattoo Studio</span>{letters.map((l, i) => (
    <span class={`slot k-${colors[i]}`} style={`--i:${i}`} aria-hidden="true">
      <span class="ch"><b>{l}</b></span>
    </span>
  ))}</h1>
  <div class="hero-meta">
    <p class="lead">{studio.tagline}</p>
    <div class="side mono">{studio.days} · {studio.hours}<br>{studio.address}, {studio.city}</div>
  </div>
</section>

<style>
#hero{min-height:min(100svh,980px);display:flex;flex-direction:column;justify-content:flex-end;padding-block:120px 150px;overflow:hidden;isolation:isolate}
#speed{position:absolute;inset:0;width:100%;height:100%;z-index:-1;opacity:.7}
.hero-title{font-family:var(--display);font-weight:400;font-size:clamp(64px,17.4vw,300px);line-height:.86;letter-spacing:-.02em;display:flex;justify-content:space-between;margin:0}
.ch{display:inline-block;overflow:hidden;padding:.14em .12em .06em;margin:-.14em -.12em -.06em}
.ch b{display:inline-block;font-weight:400;color:var(--k);-webkit-text-stroke:3px var(--ink);paint-order:stroke;text-shadow:.04em .04em 0 var(--paper);filter:drop-shadow(0 0 .02em color-mix(in srgb, var(--k) 65%, transparent)) drop-shadow(0 0 .07em color-mix(in srgb, var(--k) 45%, transparent));transform:translateY(105%);transition:transform 1s cubic-bezier(.2,.9,.1,1)}
:global(.ready) .ch b{transform:none}
.ch b{transition-delay:calc(var(--i) * .06s)}
.slot{position:relative;display:inline-block}
.slot:hover b{animation:jump .5s cubic-bezier(.3,1.8,.5,1)}
@keyframes jump{40%{transform:translateY(-14%) rotate(-6deg)}}
.hero-meta{display:grid;gap:24px;margin-top:32px;align-items:end}
@media(min-width:900px){.hero-meta{grid-template-columns:repeat(12,1fr)}.lead{grid-column:1/6}.side{grid-column:8/13;justify-self:end;text-align:right}}
.lead{font-size:clamp(17px,1.6vw,22px);max-width:34ch;margin:0;text-wrap:balance}
.side{color:var(--c-cyan);font-size:13px}
.kanji-v{position:absolute;right:max(16px,3vw);top:140px;writing-mode:vertical-rl;font-family:var(--display);font-size:clamp(36px,4.4vw,68px);line-height:1;color:var(--c-rose);letter-spacing:.1em}
.kanji-v small{display:block;font-family:var(--body);font-weight:700;font-size:13px;color:var(--c-yellow);letter-spacing:.4em;margin-top:16px}
.sfx{position:absolute;left:7%;top:12%;font-family:var(--display);font-size:clamp(44px,7vw,120px);color:var(--c-yellow);-webkit-text-stroke:3px var(--ink);paint-order:stroke;transform:rotate(-12deg) scale(0);transition:transform .5s cubic-bezier(.3,1.8,.5,1) 1.2s}
:global(.ready) .sfx{transform:rotate(-12deg) scale(1)}
.sfx::after{content:"";position:absolute;inset:-30%;z-index:-1;background:var(--c-rose);clip-path:polygon(50% 0,58% 32%,92% 12%,68% 42%,100% 52%,66% 60%,84% 94%,52% 70%,30% 100%,34% 64%,0 74%,28% 50%,4% 22%,38% 34%)}
</style>
