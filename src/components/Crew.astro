---
// "La crew": 6 chibi originali dello studio, uno sopra ogni lettera di SENPAI.
interface Props { kind: 'drago' | 'lottatrice' | 'pirata' | 'ninja' | 'soldato' | 'mago' }
const { kind } = Astro.props;
const S = '#120f1a', SKIN = '#ffe1cc';
---
<svg class={`crew crew-${kind}`} viewBox="0 0 120 150" aria-hidden="true">
  {kind === 'drago' && (<g>
    <path class="flap" d="M30 78 L4 52 L14 88 Z M90 78 L116 52 L106 88 Z" fill="#ffd23f" stroke={S} stroke-width="4" stroke-linejoin="round"/>
    <path class="tail" d="M88 120 Q116 118 112 92" fill="none" stroke={S} stroke-width="12" stroke-linecap="round"/>
    <path class="tail" d="M88 120 Q116 118 112 92" fill="none" stroke="#7c4dff" stroke-width="6" stroke-linecap="round"/>
    <path class="fire" d="M112 92 Q100 76 112 64 Q114 76 122 72 Q124 88 112 92 Z" fill="#ff2e63" stroke={S} stroke-width="3"/>
    <ellipse cx="60" cy="112" rx="32" ry="30" fill="#7c4dff" stroke={S} stroke-width="4"/>
    <ellipse cx="60" cy="118" rx="18" ry="18" fill="#fff6ec" stroke={S} stroke-width="3"/>
    <path d="M38 34 L34 14 L50 28 Z M82 34 L86 14 L70 28 Z" fill="#fff6ec" stroke={S} stroke-width="4" stroke-linejoin="round"/>
    <circle cx="60" cy="58" r="32" fill="#7c4dff" stroke={S} stroke-width="4"/>
    <ellipse cx="60" cy="72" rx="18" ry="11" fill="#b9a3ff"/>
    <g class="eyes"><ellipse cx="46" cy="54" rx="6" ry="9" fill={S}/><ellipse cx="74" cy="54" rx="6" ry="9" fill={S}/><circle cx="48" cy="50" r="2.5" fill="#fff"/><circle cx="76" cy="50" r="2.5" fill="#fff"/></g>
    <circle cx="54" cy="70" r="2" fill={S}/><circle cx="66" cy="70" r="2" fill={S}/>
  </g>)}

  {kind === 'lottatrice' && (<g>
    <circle cx="28" cy="34" r="14" fill="#ff8fab" stroke={S} stroke-width="4"/><circle cx="92" cy="34" r="14" fill="#ff8fab" stroke={S} stroke-width="4"/>
    <rect x="34" y="88" width="52" height="54" rx="18" fill="#ff2e63" stroke={S} stroke-width="4"/>
    <rect x="34" y="112" width="52" height="8" fill="#120f1a"/>
    <g class="punch"><circle cx="24" cy="98" r="10" fill={SKIN} stroke={S} stroke-width="4"/><circle cx="96" cy="98" r="10" fill={SKIN} stroke={S} stroke-width="4"/></g>
    <circle cx="60" cy="58" r="32" fill={SKIN} stroke={S} stroke-width="4"/>
    <path d="M28 54 Q34 22 60 24 Q86 22 92 54 Q80 38 60 40 Q44 38 28 54 Z" fill="#ff8fab" stroke={S} stroke-width="4" stroke-linejoin="round"/>
    <g class="eyes"><path d="M42 58 L52 62 L42 66" fill="none" stroke={S} stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/><path d="M78 58 L68 62 L78 66" fill="none" stroke={S} stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/></g>
    <path d="M54 76 Q60 82 66 76" fill="none" stroke={S} stroke-width="3" stroke-linecap="round"/>
  </g>)}

  {kind === 'pirata' && (<g>
    <rect x="34" y="88" width="52" height="54" rx="18" fill="#fff6ec" stroke={S} stroke-width="4"/>
    <path d="M36 102 H84 M36 114 H84 M36 126 H84" stroke="#2f6bff" stroke-width="5"/>
    <circle cx="60" cy="60" r="31" fill={SKIN} stroke={S} stroke-width="4"/>
    <path class="hat" d="M14 40 Q60 52 106 40 Q96 6 60 8 Q24 6 14 40 Z" fill={S}/>
    <path d="M24 38 Q60 46 96 38" fill="none" stroke="#ffd23f" stroke-width="4"/>
    <circle cx="60" cy="24" r="6" fill="#ffd23f"/>
    <g class="eyes"><ellipse cx="72" cy="60" rx="5" ry="8" fill={S}/><circle cx="74" cy="56" r="2" fill="#fff"/></g>
    <path d="M30 50 L76 62" stroke={S} stroke-width="3"/><ellipse cx="46" cy="60" rx="10" ry="9" fill={S}/>
    <path d="M50 76 Q62 84 72 74" fill="none" stroke={S} stroke-width="3" stroke-linecap="round"/>
  </g>)}

  {kind === 'ninja' && (<g>
    <path class="scarf" d="M80 84 Q104 80 116 92 Q102 94 96 104 Q90 92 80 94 Z" fill="#22d3ee" stroke={S} stroke-width="3" stroke-linejoin="round"/>
    <rect x="34" y="88" width="52" height="54" rx="18" fill="#2f2a3d" stroke={S} stroke-width="4"/>
    <rect x="30" y="82" width="60" height="12" rx="6" fill="#22d3ee" stroke={S} stroke-width="3"/>
    <circle cx="60" cy="56" r="32" fill="#2f2a3d" stroke={S} stroke-width="4"/>
    <rect x="34" y="46" width="52" height="20" rx="10" fill={SKIN} stroke={S} stroke-width="3"/>
    <g class="eyes"><path d="M42 58 Q48 50 54 58" fill={S}/><path d="M66 58 Q72 50 78 58" fill={S}/></g>
    <path d="M30 40 Q60 30 90 40" fill="none" stroke="#22d3ee" stroke-width="5"/>
  </g>)}

  {kind === 'soldato' && (<g>
    <rect x="34" y="88" width="52" height="54" rx="16" fill="#ff2e63" stroke={S} stroke-width="4"/>
    <path d="M36 104 H84 M36 120 H84" stroke={S} stroke-width="3"/>
    <circle cx="60" cy="60" r="31" fill={SKIN} stroke={S} stroke-width="4"/>
    <path class="hat" d="M60 6 L52 26 L60 22 L68 26 Z" fill="#ffd23f" stroke={S} stroke-width="3" stroke-linejoin="round"/>
    <path d="M26 56 Q26 22 60 22 Q94 22 94 56 L84 50 Q60 40 36 50 Z" fill="#c9c2d6" stroke={S} stroke-width="4" stroke-linejoin="round"/>
    <g class="eyes"><ellipse cx="48" cy="62" rx="5" ry="7" fill={S}/><ellipse cx="72" cy="62" rx="5" ry="7" fill={S}/><circle cx="49" cy="59" r="2" fill="#fff"/><circle cx="73" cy="59" r="2" fill="#fff"/></g>
    <path d="M52 78 H68" stroke={S} stroke-width="3" stroke-linecap="round"/>
  </g>)}

  {kind === 'mago' && (<g>
    <g class="staff"><path d="M98 140 L104 70" stroke={S} stroke-width="6" stroke-linecap="round"/><path d="M104 54 L108 64 L118 66 L110 72 L112 82 L104 76 L96 82 L98 72 L90 66 L100 64 Z" fill="#ffd23f" stroke={S} stroke-width="3" stroke-linejoin="round"/></g>
    <path d="M30 142 Q34 90 60 88 Q86 90 90 142 Z" fill="#ff7a1a" stroke={S} stroke-width="4" stroke-linejoin="round"/>
    <circle cx="60" cy="62" r="30" fill={SKIN} stroke={S} stroke-width="4"/>
    <path class="hat" d="M22 46 Q60 58 98 46 L72 36 L62 2 L48 36 Z" fill="#6d28d9" stroke={S} stroke-width="4" stroke-linejoin="round"/>
    <circle cx="58" cy="26" r="3" fill="#ffd23f"/><circle cx="66" cy="40" r="2.5" fill="#ffd23f"/>
    <g class="eyes"><path d="M42 64 Q48 58 54 64" fill="none" stroke={S} stroke-width="4" stroke-linecap="round"/><path d="M66 64 Q72 58 78 64" fill="none" stroke={S} stroke-width="4" stroke-linecap="round"/></g>
    <ellipse cx="40" cy="74" rx="6" ry="4" fill="#ff8fab"/><ellipse cx="80" cy="74" rx="6" ry="4" fill="#ff8fab"/>
    <path d="M54 78 Q60 84 66 78" fill="none" stroke={S} stroke-width="3" stroke-linecap="round"/>
  </g>)}
</svg>

<style>
.crew{display:block;width:100%;height:auto;overflow:visible}
.eyes{transform-box:fill-box;transform-origin:center;animation:blinkEyes 4.5s infinite}
.flap{transform-box:fill-box;transform-origin:center;animation:flap .5s ease-in-out infinite alternate}
.fire{transform-box:fill-box;transform-origin:bottom;animation:fire .3s steps(2) infinite}
.punch{animation:punch .9s ease-in-out infinite}
.scarf,.cape{transform-box:fill-box;transform-origin:left top;animation:flutter .6s ease-in-out infinite alternate}
.cape{transform-origin:top center}
.staff{transform-box:fill-box;transform-origin:bottom;animation:sway 1.4s ease-in-out infinite alternate}
.hat{transform-box:fill-box;transform-origin:bottom;animation:sway 2s ease-in-out infinite alternate}
@keyframes blinkEyes{0%,92%,100%{transform:scaleY(1)}95%{transform:scaleY(.1)}}
@keyframes flap{to{transform:scaleY(.75)}}
@keyframes fire{50%{transform:scale(1.25)}}
@keyframes punch{50%{transform:translateY(-6px)}}
@keyframes flutter{to{transform:skewY(-8deg) scaleX(1.1)}}
@keyframes sway{to{transform:rotate(-6deg)}}
</style>
