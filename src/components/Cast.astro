---
import { Image } from 'astro:assets';
import { artists } from '../data/site';
// Foto artista opzionale: src/assets/artists/<slug>.jpg|png|webp
const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/artists/*.{jpg,jpeg,png,webp,avif}', { eager: true });
const photoOf = (slug: string) => Object.entries(photos).find(([p]) => p.split('/').pop()!.split('.')[0] === slug)?.[1].default;
---
<section id="cast" class="cast-sec wrap pad" data-ch="CH.02">
  <div class="chapter"><h2>Il cast</h2><span class="mono">4 artisti · passa sopra una carta</span></div>
  <div class="cast">
    {artists.map((a, i) => {
      const photo = photoOf(a.slug);
      return (
        <article class={`card rv k-${a.color}`} tabindex="0" style={`--i:${i}`}>
          <div class="art">
            {photo ? <Image src={photo} alt={`Ritratto di ${a.name}`} widths={[400, 800]} sizes="(min-width: 900px) 25vw, 100vw" class="photo" quality={72} />
                   : <><div class="tone"></div><span class="glyph" aria-hidden="true">{a.glyph}</span><span class="ph mono">Foto in arrivo</span></>}
            <div class="bubble">{a.bubble}</div>
          </div>
          <div class="info">
            <span class="mono role">{a.role}</span>
            <h3>{a.name}</h3>
            {a.instagram && <a class="mono ig" href={a.instagram} target="_blank" rel="noopener">Instagram ↗</a>}
          </div>
        </article>
      );
    })}
  </div>
</section>

<style>
.cast-sec{background:var(--paper);color:var(--ink);overflow:hidden}
.cast{display:grid;grid-template-columns:1fr;gap:24px}
@media(min-width:640px){.cast{grid-template-columns:repeat(2,1fr)}}
@media(min-width:1100px){.cast{grid-template-columns:repeat(4,1fr)}}
.card{display:flex;flex-direction:column;position:relative;border:3px solid var(--ink);background:var(--k);cursor:pointer;transition:transform .35s cubic-bezier(.2,.9,.1,1),box-shadow .35s;transition-delay:calc(var(--i) * 80ms)}
.card:hover,.card:focus-visible{transform:translate(-6px,-6px) rotate(-1deg);box-shadow:8px 8px 0 var(--ink);transition-delay:0s}
.art{aspect-ratio:4/5;position:relative;display:grid;place-items:center;overflow:hidden;border-bottom:3px solid var(--ink);color:var(--ink)}
:global(.photo){position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:50% 30%}
.tone{position:absolute;inset:0;opacity:.25;transition:transform .6s}
.card:hover .tone{transform:scale(1.2) rotate(4deg)}
.glyph{font-family:var(--display);font-size:clamp(110px,12vw,180px);line-height:1;color:var(--paper);-webkit-text-stroke:4px var(--ink);paint-order:stroke;position:relative;transition:transform .5s cubic-bezier(.3,1.6,.5,1)}
.card:hover .glyph{transform:scale(1.1) rotate(-6deg)}
.ph{position:absolute;left:12px;bottom:10px}
.bubble{position:absolute;left:12px;right:12px;top:12px;background:var(--paper);border:3px solid var(--ink);border-radius:24px;padding:12px 16px;font-weight:700;font-size:14px;line-height:1.35;transform:scale(0);transform-origin:20% 100%;transition:transform .35s cubic-bezier(.3,1.7,.5,1)}
.bubble::after{content:"";position:absolute;left:28px;bottom:-14px;border:10px solid transparent;border-top:12px solid var(--ink);border-bottom:0}
.card:hover .bubble,.card:focus-visible .bubble{transform:scale(1)}
@media (hover:none){.bubble{transform:scale(1)}}
.info{flex:1;padding:14px 16px 18px;display:grid;gap:4px;background:var(--paper)}
.role{color:#4a4458}
h3{font-family:var(--display);font-weight:400;font-size:clamp(22px,2vw,28px);margin:0;line-height:1.05}
.ig{text-decoration:none;min-height:44px;display:inline-flex;align-items:center}
</style>
